<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HollowKnightTAS.ClockPayload</AssemblyName>
    <RootNamespace>HollowKnightTAS.ClockPayload</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\HollowKnightTAS.Runtime\FullRun\ResidentDirectorFence.cs" Link="ResidentDirectorFence.cs" />
    <Compile Include="..\HollowKnightTAS.Core\Ipc\RecordingRootConfiguration.cs" Link="RecordingRootConfiguration.cs" />
    <Compile Include="..\HollowKnightTAS.Core\Movie\NativeExecutionProfile.cs" Link="NativeExecutionProfile.cs" />
    <Compile Include="..\HollowKnightTAS.Core\Movie\ModWallClock.cs" Link="ModWallClock.cs" />
    <Compile Include="..\HollowKnightTAS.Core\Movie\SessionAchievements.cs" Link="SessionAchievements.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\HollowKnightTAS.Core\SceneCheckpoints\CheckpointRandomState.cs" Link="CheckpointRandomState.cs" />
    <Compile Include="..\HollowKnightTAS.Core\SceneCheckpoints\CheckpointClockObserverState.cs" Link="CheckpointClockObserverState.cs" />
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(HKManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(HKManagedDir)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(HKManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(HKManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(HKManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_Assembly-CSharp">
      <HintPath>$(HKManagedDir)\MMHOOK_Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(HKManagedDir)\MonoMod.RuntimeDetour.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(HKManagedDir)\MonoMod.Utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(HKManagedDir)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateLocalBuildConfig" BeforeTargets="ResolveReferences">
    <Error Condition="'$(HKManagedDir)' == ''"
           Text="HKManagedDir is required for the clock payload." />
    <Error Condition="!Exists('$(HKManagedDir)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll was not found under HKManagedDir." />
    <Error Condition="!Exists('$(HKManagedDir)\MMHOOK_Assembly-CSharp.dll')"
           Text="MMHOOK_Assembly-CSharp.dll was not found under HKManagedDir." />
  </Target>
</Project>

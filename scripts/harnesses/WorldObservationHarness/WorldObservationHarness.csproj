<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HKTASCompanionCandidateDir Condition="'$(HKTASCompanionCandidateDir)' == ''">D:/SteamLibrary/steamapps/common/Hollow Knight/hollow_knight_Data/Managed/Mods/HollowKnightTAS/Companion/win-x64</HKTASCompanionCandidateDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HollowKnightTAS.Core">
      <HintPath>$(HKTASCompanionCandidateDir)/HollowKnightTAS.Core.dll</HintPath>
    </Reference>
    <Reference Include="HollowKnightTAS.Companion">
      <HintPath>$(HKTASCompanionCandidateDir)/HollowKnightTAS.Companion.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="PinSharedCompanionRuntime" BeforeTargets="ProcessFrameworkReferences" Condition="'$(HKTASSharedRuntimeVersion)' != ''">
    <ItemGroup>
      <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App.WPF" RuntimeFrameworkVersion="$(HKTASSharedRuntimeVersion)" />
    </ItemGroup>
  </Target>
</Project>
